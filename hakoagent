def _cmd_graph_ingest_traces(args):
    """Ingest execution traces into the knowledge graph."""
    if len(args) < 4:
        print("Usage: hakoagent graph ingest-traces <trace-file> [--actor <actor>]")
        return 1
    trace_file = args[3]
    actor = "agent"
    i = 4
    while i < len(args):
        if args[i] == "--actor" and i + 1 < len(args):
            actor = args[i + 1]
            i += 2
        else:
            i += 1

    try:
        import json as _json
        with open(trace_file, "r", encoding="utf-8") as f:
            traces = _json.load(f)
    except (OSError, ValueError) as e:
        print(f"Error: Cannot read trace file: {e}")
        return 1

    if isinstance(traces, dict):
        traces = [traces]

    trace_count = 0
    edge_count = 0
    _ensure_dirs()
    for trace in traces:
        trace_id = trace.get("trace_id", f"trace_{uuid.uuid4().hex[:12]}")
        trace_doc = {
            "trace_id": trace_id,
            "timestamp": trace.get("timestamp", now_iso()),
            "span_id": trace.get("span_id", ""),
            "parent_span_id": trace.get("parent_span_id", ""),
            "operation": trace.get("operation", ""),
            "service": trace.get("service", ""),
            "duration_ms": trace.get("duration_ms", 0),
            "actor": actor,
        }
        save_doc("traces", trace_id, trace_doc)
        trace_count += 1
        # Create edge from parent to child span
        if trace.get("parent_span_id"):
            edge_id = f"edge_{uuid.uuid4().hex[:12]}"
            save_doc("code_edges", edge_id, {
                "edge_id": edge_id,
                "source_id": trace.get("parent_span_id", ""),
                "target_id": trace_id,
                "edge_type": "calls-async",
                "confidence": 1.0,
                "line_number": 0,
                "actor": actor,
            })
            edge_count += 1

    print(f"Ingested {trace_count} traces, {edge_count} edges from {trace_file}")
    return 0


