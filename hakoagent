def cmd_bug_scan(args):
    """Scan indexed code for common bug patterns."""
    patterns = {
        "bare_except": r"^\s*except\s*:",
        "bare_raise": r"^\s*raise\s*$",
        "print_debug": r"\bprint\s*\(",
        "hardcoded_secret": r"(?i)(password|secret|api_key|token)\s*=\s*['\"][^'\"]{4,}",
        "todo_in_code": r"(TODO|FIXME|XXX|HACK)",
        "eval_usage": r"\beval\s*\(",
        "exec_usage": r"\bexec\s*\(",
    }
    findings = []
    total_files = 0
    for doc_id, doc in scan_docs("code_index"):
        fp = doc.get("file_path", "")
        if not fp.endswith((".py", ".rs", ".js", ".ts", ".go")):
            continue
        total_files += 1
        # Re-read file content to scan for patterns
        try:
            text = Path(fp).read_text(encoding="utf-8", errors="ignore")
        except (OSError, UnicodeDecodeError):
            continue
        for line_num, line in enumerate(text.splitlines(), 1):
            for name, pat in patterns.items():
                import re
                if re.search(pat, line):
                    findings.append((fp, line_num, name, line.strip()[:80]))
    print("=== Bug Pattern Scan ===")
    print(f"Files scanned: {total_files}")
    print(f"Findings: {len(findings)}")
    print()
    if findings:
        # Group by pattern
        by_pattern = {}
        for fp, line_num, name, line in findings:
            by_pattern.setdefault(name, []).append((fp, line_num, line))
        for name, items in sorted(by_pattern.items()):
            print(f"  {name}: {len(items)} occurrence(s)")
            for fp, line_num, line in items[:5]:
                print(f"    {fp}:{line_num}: {line}")
            if len(items) > 5:
                print(f"    ... and {len(items) - 5} more")
    else:
        print("  No issues found.")
    print()
    print("  Tip: Run 'hakoagent recall <query>' to find related fixes.")
    print("  Tip: Run 'hakoagent task create' to track bug fixes.")
    return 0


