def cmd_cache(args):
    if len(args) < 3:
        print("Usage: hakoagent cache <stats|get|put> [args]")
        return 1
    sub = args[2]
    if sub == "stats":
        fmt, args = _parse_format(args[2:])
        hits = size = 0
        for doc_id, doc in scan_docs("context_cache"):
            if doc_id == "_evictions":
                continue
            size += 1
            hits += doc.get("hit_count", 0)
        misses = _get_cache_misses()
        total = hits + misses
        hit_rate = f"{(hits/total*100):.0f}%" if total > 0 else "0%"
        evictions = _get_evictions()
        if fmt == "table":
            print(_format_table(["metric", "value"], [
                ["total hits", str(hits)],
                ["total misses", str(misses)],
                ["hit rate", hit_rate],
                ["cache size", str(size)],
                ["eviction count", str(evictions)],
            ]))
        else:
            print("Cache Statistics:")
            print(f"  Total hits: {hits}")
            print(f"  Total misses: {misses}")
            print(f"  Hit rate: {hit_rate}")
            print(f"  Cache size: {size}")
            print(f"  Eviction count: {evictions}")
    elif sub == "get":
        if len(args) < 4:
            print("Usage: hakoagent cache get <query>")
            return 1
        query = " ".join(args[3:])
        doc = cache_get_internal(query)
        if doc:
            print(f"Query: {query}")
            print("  Result: cache hit")
            print(f"  Summary: {doc.get('summary','')}")
        else:
            print(f"Query: {query}")
            print("  Result: cache miss (no cached result found)")
    elif sub == "put":
        if len(args) < 5:
            print("Usage: hakoagent cache put <query> <summary> [ttl_seconds]")
            return 1
        query = args[3]
        summary = args[4]
        ttl = int(args[5]) if len(args) > 5 else DEFAULT_TTL
        key = cache_put_internal(query, summary, ttl)
        print("Cache entry stored:")
        print(f"  Query: {query}")
        print(f"  Summary: {summary}")
        print(f"  TTL: {ttl} seconds")
        print(f"  Cache key: {key}")
    else:
        print(f"Unknown cache subcommand: {sub}")
        return 1
    return 0


