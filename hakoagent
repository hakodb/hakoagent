def cmd_revision(args):
    if len(args) < 3:
        print("Usage: hakoagent revision <list|prune> ...")
        print("  hakoagent revision.list <doc_id> <doc_collection>")
        print("  hakoagent revision prune [--dry-run] [--all --yes]")
        return 1
    sub = args[2]
    if sub == "list":
        if len(args) < 5:
            print("Usage: hakoagent revision.list <doc_id> <doc_collection>")
            return 1
        doc_id = args[3]
        doc_collection = args[4]
        revisions = []
        for rid in list_docs("revisions"):
            doc = load_doc("revisions", rid) or {}
            if doc.get("doc_id") == doc_id and doc.get("doc_collection") == doc_collection:
                revisions.append(doc)
        # Sort by changed_at (chronological)
        revisions.sort(key=lambda r: r.get("changed_at", ""))
        if not revisions:
            print(f"No revisions found for {doc_collection}/{doc_id}")
            return 0
        print(f"Revisions for {doc_collection}/{doc_id} ({len(revisions)}):")
        for r in revisions:
            print(f"  - {r['revision_id']} | changed_by: {r.get('changed_by', '?')} | {r.get('changed_at', '?')}")
            print(f"    previous: {str(r.get('previous_content', ''))[:80]}...")
            print(f"    new:      {str(r.get('new_content', ''))[:80]}...")
    elif sub == "prune":
        # Volatile collections stopped producing revisions in fix 8; this
        # cleans up the backlog and any future accidental churn.
        dry_run = "--dry-run" in args[3:]
        all_revisions = "--all" in args[3:]
        if all_revisions and "--yes" not in args[3:]:
            print("Refusing to prune all revisions without --yes "
                  "(that deletes durable history).")
            return 1
        targets = None if all_revisions else set(REVISION_EXEMPT_COLLECTIONS)
        removed = 0
        freed = 0
        for rid in list_docs("revisions"):
            doc = load_doc("revisions", rid) or {}
            if targets is not None and doc.get("doc_collection") not in targets:
                continue
            try:
                size = (_coll_dir("revisions") / (rid + ".json")).stat().st_size
            except OSError:
                size = 0
            if dry_run or delete_doc("revisions", rid):
                removed += 1
                freed += size
        scope = "all collections" if all_revisions else "volatile collections"
        verb = "Would remove" if dry_run else "Removed"
        print(f"{verb} {removed} revision(s) ({freed} bytes) from {scope}.")
    else:
        print(f"Unknown revision subcommand: {sub}")
        return 1
    return 0


