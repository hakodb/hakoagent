        print(f"  - {p.get('project_name', '?')} | {p.get('root_path', '?')}")
        print(f"    Indexed: {p.get('indexed_at', '?')} | Nodes: {p.get('node_count', 0)} | Edges: {p.get('edge_count', 0)}")
    return 0


def _cmd_graph_delete_project(args):
    """Delete a project and all its graph data."""
    if len(args) < 4:
        print("Usage: hakoagent graph delete-project <project_name>")
        return 1
    project_name = args[3]
    # Find project
    target_id = None
    target_doc = None
    for doc_id in list_docs("projects"):
        doc = load_doc("projects", doc_id) or {}
        if doc.get("project_name") == project_name:
            target_id = doc_id
            target_doc = doc
            break
    if target_doc is None:
        print(f"Project not found: {project_name}")
        return 1
    # Remove project doc
    delete_doc("projects", target_id)
    nodes_removed = 0
    edges_removed = 0
    # Remove code_index and code_edges entries for this project
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc and doc.get("actor") == target_doc.get("actor"):
            delete_doc("code_index", doc_id)
            nodes_removed += 1
    for doc_id in list_docs("code_edges"):
        doc = load_doc("code_edges", doc_id)
        if doc and doc.get("actor") == target_doc.get("actor"):
            delete_doc("code_edges", doc_id)
            edges_removed += 1
    print(f"Deleted project: {project_name}")
    print(f"  Nodes removed: {nodes_removed}")
    print(f"  Edges removed: {edges_removed}")
    return 0


