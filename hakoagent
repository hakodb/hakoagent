def cmd_vigilance(args):
    fmt, args = _parse_format(args[2:])
    print("=== Vigilance Check ===")
    # Modified without test: scan for .py/.rs files without corresponding test
    modified_without_test = 0
    total_modified = 0
    total_with_test = 0
    for doc_id, doc in scan_docs("code_index"):
        fp = doc.get("file_path", "")
        if fp.endswith((".py", ".rs")):
            total_modified += 1
            base = fp.rsplit(".", 1)[0]
            test_exists = any(
                d.get("file_path", "").startswith(base) and "test" in d.get("file_path", "").lower()
                for _, d in scan_docs("code_index")
            )
            if test_exists:
                total_with_test += 1
            else:
                modified_without_test += 1

    todo_count = 0
    for path in ROOT.rglob("*"):
        if not path.is_file():
            continue
        parts = path.relative_to(ROOT).parts
        if any(p in (".git", "target", "__pycache__", ".hakoagent", "node_modules") for p in parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except (OSError, UnicodeDecodeError):
            continue
        for marker in ("TODO", "FIXME", "XXX"):
            todo_count += text.count(marker)

    if fmt == "table":
        print(_format_table(["category", "count"], [
            ["Modified without test", str(modified_without_test)],
            ["Total modified", str(total_modified)],
            ["Total with test", str(total_with_test)],
            ["Total TODO/FIXME/XXX", str(todo_count)],
        ]))
    else:
        print("[Unused Files]")
        print(f"  Modified without test: {modified_without_test}")
        print(f"  Total modified: {total_modified}")
        print(f"  Total with test: {total_with_test}")
    print()
    print("[TODO Items]")
    print(f"  Total TODO/FIXME/XXX: {todo_count}")
    print()
    print("[Constitution Regression]")
    checks = [
        ("Constitution exists", Path(".specify/memory/constitution.md").exists()),
        ("Memory collections exist", HAKO_DIR.exists()),
        ("Events collection (append-only)", (MEMORY_DIR / "events").exists()),
    ]
    passed = sum(1 for _, ok in checks if ok)
    print(f"  Passed: {passed}/{len(checks)}")
    for name, ok in checks:
        status = "PASS" if ok else "FAIL"
        print(f"  [{status}] {name}: {'found' if ok else 'missing'}")
    print()
    print("  Tip: Run 'hakoagent recall <query>' to investigate findings.")
    print("  Tip: Run 'hakoagent suggest' for recall ideas based on recent activity.")
    return 0


