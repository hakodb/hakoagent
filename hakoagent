# Sync enable
def _mcp_sync_enable(args):
    sync_type = args.get("type", "mesh")
    room_key = args.get("room_key", "")
    port = args.get("port", 9876)
    server_url = args.get("server_url", None)
    api_token = args.get("api_token", None)
    actor = args.get("actor", "agent")

    # Save sync config
    config = _load_sync_config()
    config["enabled"] = True
    config["type"] = sync_type
    config["room_key"] = room_key
    config["port"] = port
    config["server_url"] = server_url
    config["api_token"] = api_token
    config["started_at"] = now_iso()
    config["actor"] = actor
    _save_sync_config(config)

    # Start net syncer for mesh
    engine = _get_engine()
    syncer = None
    if sync_type == "mesh" and engine:
        syncer = hk_net_syncer_new(engine, "hakoagent", room_key or "")
        if syncer:
            hk_net_syncer_set_discovery(syncer, 2)
            rc = hk_net_syncer_start(syncer, port)
            if rc == 0:
                _set_net_syncer(syncer)
    elif sync_type == "cloud":
        cloud_syncer = hk_cloud_sync_new(server_url or "", api_token or "", room_key or "")
        if cloud_syncer:
            hk_cloud_sync_start(cloud_syncer)
            _set_net_syncer(cloud_syncer)

    return {"enabled": True, "type": sync_type, "room_key": room_key, "port": port}

# Sync disable
def _mcp_sync_disable(args):
    config = _load_sync_config()
    config["enabled"] = False
    config["type"] = None
    config["started_at"] = None
    _save_sync_config(config)
    _free_net_syncer()
    return {"enabled": False}

# Sync status
def _mcp_sync_status(args):
    config = _load_sync_config()
    syncer = _get_net_syncer()
    result = {
        "enabled": config.get("enabled", False),
        "type": config.get("type"),
        "room_key": config.get("room_key"),
        "peers": [],
        "pending_changes": 0,
    }
    if syncer:
        try:
            status_str = hk_net_syncer_status(syncer)
            if status_str:
                import json as _json
                try:
                    result["syncer_status"] = _json.loads(status_str)
                except _json.JSONDecodeError:
                    result["syncer_status_raw"] = status_str
        except Exception:
            pass
    return result

# Sync now
def _mcp_sync_sync_now(args):
    if not _is_sync_enabled():
        return {"error": "Sync not enabled"}
    syncer = _get_net_syncer()
    if not syncer:
        return {"changes_synced": 0, "peers_contacted": 0, "message": "No active syncer"}
    try:
        status_str = hk_net_syncer_status(syncer)
        if status_str:
            import json as _json
            try:
                status_json = _json.loads(status_str)
                peers = status_json.get("peers", [])
                return {"changes_synced": 0, "peers_contacted": len(peers)}
            except _json.JSONDecodeError:
                return {"changes_synced": 0, "peers_contacted": 0}
        return {"changes_synced": 0, "peers_contacted": 0}
    except Exception:
        return {"changes_synced": 0, "peers_contacted": 0}

# Sync backup
def _mcp_sync_backup(args):
    backup_path = args.get("path", "")
    if not backup_path:
        return {"error": "path required"}
    engine = _get_engine()
    if not engine:
        return {"error": "No engine available"}
    rc = hk_engine_backup(engine, backup_path)
    if rc == 0:
        return {"backup_path": backup_path, "status": "success"}
    else:
        return {"backup_path": backup_path, "status": "failed"}

