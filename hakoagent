def _dijkstra(nodes, adj, rev_adj, src, dst):
    src = _resolve_node(nodes, src, adj, rev_adj)
    dst = _resolve_node(nodes, dst, adj, rev_adj)
    if src is None or dst is None:
        return None
    dist = {src: 0.0}
    prev = {}
    pq = [(0.0, src)]
    visited = set()
    while pq:
        d, u = heapq.heappop(pq)
        if u in visited:
            continue
        visited.add(u)
        if u == dst:
            break
        for v, w in adj.get(u, []):
            nd = d + w
            if nd < dist.get(v, float("inf")):
                dist[v] = nd
                prev[v] = u
                heapq.heappush(pq, (nd, v))
    if dst not in dist:
        return None
    path = []
    cur = dst
    while cur != src:
        path.append(cur)
        cur = prev[cur]
    path.append(src)
    path.reverse()
    return {"visited_nodes": path, "edges_traversed": [(path[i], path[i+1]) for i in range(len(path)-1)], "distance": dist[dst]}


def _dependents(nodes, rev_adj, node):
    node = _resolve_node(nodes, node, {}, rev_adj)
    if node is None:
        return []
    return [n for n, _ in rev_adj.get(node, [])]


def _dependents_reverse(nodes, adj, rev_adj, node):
    node = _resolve_node(nodes, node, adj, rev_adj)
    if node is None:
        return []
    return [n for n, _ in adj.get(node, [])]


