# Tool: graph_detect_changes
def _mcp_graph_detect_changes(args):
    diff_path = args.get("diff_path")
    tier = args.get("tier", "verify")
    changed_files = []
    if diff_path:
        try:
            with open(diff_path, "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("diff --git "):
                        parts = line.split()
                        for p in parts:
                            if p.startswith("a/") or p.startswith("b/"):
                                fp = p[2:]
                                if fp not in changed_files:
                                    changed_files.append(fp)
                        break
        except OSError:
            return {"error": f"Cannot read diff file: {diff_path}"}
    else:
        try:
            import subprocess
            result_proc = subprocess.run(
                ["git", "diff", "--name-only"],
                capture_output=True, text=True, timeout=10
            )
            if result_proc.returncode == 0:
                changed_files = [f for f in result_proc.stdout.strip().split("\n") if f]
        except (OSError, subprocess.TimeoutExpired, FileNotFoundError):
            pass

    nodes = {}
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc

    affected_symbols = []
    affected_files = set()
    for nid, doc in nodes.items():
        fpath = doc.get("file_path", "")
        if fpath in changed_files:
            affected_symbols.append({
                "entry_id": doc.get("entry_id", nid),
                "symbol_name": doc.get("symbol_name", ""),
                "symbol_type": doc.get("symbol_type", ""),
                "file_path": fpath,
                "change_type": "modified",
                "actor": doc.get("actor", ""),
            })
            affected_files.add(fpath)

    return {
        "changed_files": sorted(changed_files),
        "affected_symbols": affected_symbols,
        "affected_files_count": len(affected_files),
        "tier": tier,
    }

