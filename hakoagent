def _get_architecture(tier="verify"):
    """Return architecture overview: modules, dependencies, entry points (MCP get_architecture adapted)."""
    nodes = {}
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc

    modules = {}
    for nid, doc in nodes.items():
        fpath = doc.get("file_path", "")
        if fpath not in modules:
            modules[fpath] = {
                "name": fpath,
                "type": "module",
                "file_path": fpath,
                "symbol_count": 0,
                "symbols": [],
            }
        modules[fpath]["symbol_count"] += 1
        modules[fpath]["symbols"].append({
            "name": doc.get("symbol_name", ""),
            "type": doc.get("symbol_type", ""),
            "line": doc.get("line_number", 0),
        })

    dependencies = []
    for doc_id in list_docs("code_edges"):
        edge = load_doc("code_edges", doc_id)
        if edge is None:
            continue
        src_id = edge.get("source_id")
        tgt_id = edge.get("target_id")
        if src_id in nodes and tgt_id in nodes:
            src_file = nodes[src_id].get("file_path", "")
            tgt_file = nodes[tgt_id].get("file_path", "")
            if src_file != tgt_file:
                dependencies.append({
                    "from": src_file,
                    "to": tgt_file,
                    "edge_type": edge.get("edge_type", "depends-on"),
                    "strength": 1,
                })

    entry_points = []
    has_incoming = set()
    for doc_id in list_docs("code_edges"):
        edge = load_doc("code_edges", doc_id)
        if edge is None:
            continue
        has_incoming.add(edge.get("target_id"))

    for nid, doc in nodes.items():
        if nid not in has_incoming:
            sym = doc.get("symbol_name", "")
            if sym in ("main", "main_func", "app", "run") or doc.get("symbol_type") == "function":
                entry_points.append(doc.get("qualified_name", doc.get("symbol_name", "")))

    return {
        "modules": list(modules.values()),
        "dependencies": dependencies,
        "entry_points": entry_points,
        "tier": tier,
    }


