def _coll_dir(collection):
    return MEMORY_DIR / collection


def _atomic_write_text(path, text):
    """Write text to path atomically (temp file + os.replace).

    A killed MCP server or an interrupted CLI command must never leave a
    half-written JSON document behind. The temp file is created in the same
    directory so os.replace() stays atomic on the same filesystem.
    """
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(".%s.tmp.%d.%s" % (path.name, os.getpid(), uuid.uuid4().hex[:8]))
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(str(tmp), str(path))
    except Exception:
        try:
            os.unlink(str(tmp))
        except OSError:
            pass
        raise
    return path


def save_doc(collection, doc_id, doc):
    _ensure_dirs()
    path = _coll_dir(collection) / f"{doc_id}.json"
    # Append-only guard for events and revisions collections: reject overwrite of existing id
    if collection in ("events", "revisions") and path.exists():
        return False
    # Save previous version as revision before overwriting (for durable collections).
    # Volatile collections (code_index, context_cache) and no-op writes are skipped.
    if (collection != "revisions" and
            collection not in REVISION_EXEMPT_COLLECTIONS and
            path.exists()):
        old_doc = json.loads(path.read_text(encoding="utf-8"))
        if old_doc != doc:
            _save_revision(collection, doc_id, old_doc, doc)
    _atomic_write_text(path, json.dumps(doc, indent=2, ensure_ascii=False))
    # Also store in hakodb if available
    engine = _get_engine()
    if engine:
        hk_engine_put(engine, collection, doc_id, json.dumps(doc, ensure_ascii=False))
    return True


def _save_revision(collection, doc_id, old_doc, new_doc):
    """Save the previous version of a document as an immutable revision."""
    _ensure_dirs()
    rev_id = f"rev_{uuid.uuid4().hex[:12]}"
    revision = {
        "revision_id": rev_id,
        "doc_id": doc_id,
        "doc_collection": collection,
        "previous_content": old_doc,
        "new_content": new_doc,
        "changed_by": new_doc.get("actor", "unknown"),
        "changed_at": now_iso(),
    }
    save_doc("revisions", rev_id, revision)


def load_doc(collection, doc_id):
    # Try hakodb first
    engine = _get_engine()
    if engine:
        val = hk_engine_get(engine, collection, doc_id)
        if val is not None:
            try:
                return json.loads(val)
            except json.JSONDecodeError:
                pass
    path = _coll_dir(collection) / f"{doc_id}.json"
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def delete_doc(collection, doc_id):
    path = _coll_dir(collection) / f"{doc_id}.json"
    deleted = False
    if path.exists():
        path.unlink()
        deleted = True
    # Also delete from hakodb
    engine = _get_engine()
    if engine:
        hk_engine_delete(engine, collection, doc_id)
    return deleted


def list_docs(collection):
    _ensure_dirs()
    d = _coll_dir(collection)
    if not d.exists():
        return []
    return sorted(p.stem for p in d.glob("*.json"))


def scan_docs(collection):
    """Yield (doc_id, doc) for every doc in a collection."""
    _ensure_dirs()
    d = _coll_dir(collection)
    if not d.exists():
        return
    for p in sorted(d.glob("*.json")):
        try:
            yield p.stem, json.loads(p.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue


def docs_by_time(collection):
    """Return [(doc_id, doc)] sorted oldest -> newest by timestamp.

    Event ids are random UUIDs, so list_docs() order is arbitrary. Use this
    whenever "recent" or "last N" matters.
    """
    rows = []
    for doc_id in list_docs(collection):
        doc = load_doc(collection, doc_id) or {}
        ts = (doc.get("timestamp") or doc.get("created_at") or
              doc.get("started_at") or doc.get("changed_at") or "")
        rows.append((str(ts), doc_id, doc))
    rows.sort(key=lambda x: x[0])
    return [(doc_id, doc) for _, doc_id, doc in rows]


