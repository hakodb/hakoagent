_LIB_DIR = Path(__file__).resolve().parent / "lib"
_hakodb_lib = None


def _hakodb_lib_candidates():
    """Native lib files in lib/, ordered per platform (hakodb release layout).

    Linux: prefer the oldest-glibc build (glibc2.28) — it loads on every
    newer glibc; newer builds are tried in order if it fails to open.
    """
    if sys.platform == "win32":
        return sorted(_LIB_DIR.glob("hakodb-*.dll"))
    if sys.platform.startswith("linux"):
        # shortcut: no musl-core .so asset released yet, glibc-only, upgrade
        # when hakodb publishes one; macOS has no asset at all (intentional off).
        order = ("glibc2.28", "glibc2.35", "glibc2.39")
        return sorted(
            _LIB_DIR.glob("libhakodb-*.so"),
            key=lambda p: next((i + 1 for i, t in enumerate(order) if t in p.name), 0),
            reverse=True,
        )
    return []


def _hakodb_lib_load():
    """Load the prebuilt hakodb shared library; hard-fail when missing.

    Policy: no JSON fallback — hakoagent runs only on a real hakodb engine.
    """
    global _hakodb_lib
    if _hakodb_lib is None:
        for cand in _hakodb_lib_candidates():
            try:
                _hakodb_lib = CDLL(str(cand))
                break
            except OSError:
                continue  # wrong-variant build for this glibc; try the next
        if _hakodb_lib is None:
            sys.stderr.write(
                "hakoagent: hakodb native library not found/loadable under %s "
                "(platform: %s).\n"
                "hakoagent requires the hakodb engine and will not run without it\n"
                "(macOS is not supported yet).\n"
                "Install with: python install.py   (downloads the library from "
                "github.com/hakodb/hakodb releases)\n"
                % (str(_LIB_DIR), sys.platform)
            )
            sys.stderr.flush()
            sys.exit(1)
    return _hakodb_lib


def _hk_call(func_name, *args):
    """Call a hakodb FFI function safely."""
    lib = _hakodb_lib_load()
    if lib is None:
        return None
    fn = getattr(lib, func_name, None)
    if fn is None:
        return None
    return fn(*args)


def hk_engine_open(db_path):
    lib = _hakodb_lib_load()
