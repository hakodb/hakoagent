def _mcp_tool_list():
    """Return list of all registered MCP tools.
    Returns empty list when MCP is disabled for this project,
    so OpenCode doesn't advertise unavailable tools."""
    global _MCP_DISABLED
    if _MCP_DISABLED:
        return []
    return [
        {
            "name": info["name"],
            "description": info["description"],
            "inputSchema": info["inputSchema"],
        }
        for info in _MCP_TOOL_HANDLERS.values()
    ]


def _mcp_tool_call(name, arguments):
    """Dispatch an MCP tool call to the registered handler."""
    global _MCP_DISABLED
    if _MCP_DISABLED:
        return {
            "error": {
                "code": -32603,
                "message": "MCP not enabled for this project. "
                           "Run 'hakoagent mcp enable' to activate MCP, "
                           "then restart the MCP server.",
            }
        }
    if name not in _MCP_TOOL_HANDLERS:
        raise Exception("Unknown tool: " + name)
    handler = _MCP_TOOL_HANDLERS[name]["handler"]
    return handler(arguments)


def _mcp_wrap_result(result):
    """Wrap a tool handler result in MCP content format.

    The 2024-11-05 MCP spec only defines text/image/resource content blocks
    (there is no "json" type), so serialize the payload as JSON text. Tool
    level failures are flagged with isError; protocol errors stay JSON-RPC.
    """
    is_error = (isinstance(result, dict) and
                isinstance(result.get("error"), dict))
    text = json.dumps(result, indent=2, ensure_ascii=False, default=str)
    wrapped = {"content": [{"type": "text", "text": text}]}
    if is_error:
        wrapped["isError"] = True
    return wrapped


def _mcp_json_rpc_loop(engine):
    """Read JSON-RPC requests from stdin, dispatch, write responses to stdout.
    Exits when stdin EOF is detected (agent disconnects)."""
    import sys as _mcp_sys
    import json as _mcp_json

    while True:
        line = _mcp_sys.stdin.readline()
        if not line:
            # Stdin EOF -- agent disconnected
            break
        line = line.strip()
        if not line:
            continue
        try:
            req = _mcp_json.loads(line)
        except _mcp_json.JSONDecodeError:
            resp = {"jsonrpc": "2.0", "id": None,
                    "error": {"code": -32700, "message": "Parse error"}}
            _mcp_sys.stdout.write(_mcp_json.dumps(resp) + "\n")
            _mcp_sys.stdout.flush()
            continue

        req_id = req.get("id")
        method = req.get("method", "")
        params = req.get("params", {}) or {}

        try:
            if method == "initialize":
                result = {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": {
                        "name": "hakoagent",
                        "version": "1.0.0"
                    }
                }
            elif method == "tools/list":
                result = {"tools": _mcp_tool_list()}
            elif method == "tools/call":
                tool_name = params.get("name", "")
                tool_args = params.get("arguments", {}) or {}
                result = _mcp_tool_call(tool_name, tool_args)
                result = _mcp_wrap_result(result)
            elif method == "shutdown":
                result = {}
            else:
                raise Exception("Method not found: " + method)

            if req_id is not None:
                _mcp_sys.stdout.write(_mcp_json.dumps(
                    {"jsonrpc": "2.0", "id": req_id, "result": result}
                ) + "\n")
                _mcp_sys.stdout.flush()
        except Exception as e:
            if req_id is not None:
                _mcp_sys.stdout.write(_mcp_json.dumps({
                    "jsonrpc": "2.0", "id": req_id,
                    "error": {"code": -32603, "message": str(e)}
                }) + "\n")
                _mcp_sys.stdout.flush()

    # Stdin EOF -- shutdown
    _mcp_shutdown(engine)


def _mcp_shutdown(engine):
    """Shutdown the MCP server: free engine, stop net syncer, exit."""
    global _hako_engine, _NET_SYNCER
    try:
        if _NET_SYNCER is not None:
            _NET_SYNCER = None
    except Exception:
        pass
    try:
        if engine is not None:
            hk_engine_free(engine)
    except Exception:
        pass
    _hako_engine = None


def cmd_mcp(args):
    """Entry point for hakoagent-mcp. Runs as JSON-RPC 2.0 server over stdio.
    Or: hakoagent mcp <enable|disable|status> for per-project MCP control.
    Engine opens once, stays loaded for session. Shuts down on stdin EOF."""

    # Handle MCP config subcommands
    if len(args) > 2:
        sub = args[2]
        if sub == "enable":
            config_path = _mcp_enable()
            print("MCP enabled for this project.")
            if config_path:
                print("  Project config updated: %s" % config_path)
            print("  Restart OpenCode's MCP server (or run 'hakoagent-mcp') to connect.")
            return 0
        elif sub == "disable":
            config_path = _mcp_disable()
            print("MCP disabled for this project.")
            if config_path:
                print("  Project config updated: %s" % config_path)
            return 0
        elif sub == "status":
            if _mcp_is_enabled():
                print("MCP: enabled for this project.")
            else:
                print("MCP: disabled for this project.")
            config_path = _mcp_project_config_path()
            print("  Project config: %s" % (config_path or "JSONC (manual)"))
            return 0
        elif sub == "help":
            print("hakoagent mcp — Per-project MCP server control")
            print()
            print("Usage: hakoagent mcp <enable|disable|status|help>")
            print()
            print("  enable   Create .hakoagent/mcp-enabled and add hakoagent to")
            print("           the project OpenCode config (mcp.servers)")
            print("  disable  Remove the marker and the project MCP config entry")
            print("  status   Show whether MCP is enabled for this project")
            print("  help     Show this help message")
            print()
            print("MCP is OFF by default. Global install (install.py --global) does")
            print("not write MCP config to ~/.claude.json or OpenCode config.")
            print("Enable per project with: hakoagent mcp enable")
            return 0
        else:
            print(f"Unknown mcp subcommand: {sub}")
            print("  Usage: hakoagent mcp <enable|disable|status>")
            return 1

    # Check if MCP is enabled for this project.
    # If disabled, start server anyway (exit 0) so OpenCode doesn't see
    # "connection closed", but do NOT create .hakoagent/ infrastructure
    # or open the hakodb engine — just run the JSON-RPC loop with zero tools.
    global _MCP_DISABLED
    if not _mcp_is_enabled():
        _MCP_DISABLED = True
        import sys as _mcp_sys
        _mcp_sys.stderr.write("MCP: disabled for this project. Server started with no tools.\n")
        _mcp_sys.stderr.write("  Run 'hakoagent mcp enable' to activate MCP for this project.\n")
        _mcp_sys.stderr.flush()
        _mcp_json_rpc_loop(None)
        return 0

    db_path = None
    i = 3
    while i < len(args):
        if args[i] == "--db" and i + 1 < len(args):
            db_path = args[i + 1]
            i += 2
        else:
            i += 1
    # MCP is enabled — auto-init quietly (stdout is the JSON-RPC channel)
    # and let indexing run in the background so `initialize` is answered
    # immediately even on a cold, large repository.
    _auto_init(quiet=True, index_in_background=True)
    _ensure_dirs()
    engine = _get_engine(db_path)
    if engine is None:
        sys.stderr.write(
            "hakoagent: hakodb engine failed to open at %s — refusing to serve\n"
            % str(db_path or HAKO_DIR)
        )
        sys.stderr.flush()
        return 1

    _mcp_json_rpc_loop(engine)
    return 0

def main():
    # Default behavior based on executable name:
    #   hakoagent      → MCP server mode (default)
    #   hakoagent-mcp  → MCP server mode
    #   hakoagent-cli  → CLI command mode
    #
    # The cli/mcp entry points are thin launchers that exec this file with
    # HAKOAGENT_MODE set, so there is exactly one implementation to maintain.
    prog = os.path.basename(sys.argv[0])
    forced_mode = os.environ.get("HAKOAGENT_MODE")
    if forced_mode == "cli":
        prog = "hakoagent-cli"
    elif forced_mode == "mcp":
        prog = "hakoagent-mcp"
    if prog == "hakoagent-cli":
        cmd = sys.argv[1] if len(sys.argv) > 1 else None
        if cmd is None:
            print_help()
            return 0
    else:
        # hakoagent or hakoagent-mcp → MCP server mode by default
        cmd = sys.argv[1] if len(sys.argv) > 1 else "mcp"

    # Resolve the session lazily. A disabled MCP server must not write a
    # session document (or create .hakoagent/) just by being spawned.
    mcp_admin = (cmd == "mcp" and len(sys.argv) > 2 and
                 sys.argv[2] in ("enable", "disable", "status", "help"))
    no_session = os.environ.get("HAKOAGENT_NO_SESSION") == "1"
    if not no_session and not mcp_admin and (cmd != "mcp" or _mcp_is_enabled()):
        _ensure_session()

    # Do not auto-init for MCP mode — let cmd_mcp handle initialization
    # only when MCP is enabled for this project. Non-hakoagent projects
    # should not get .hakoagent/ infrastructure created automatically.
    # `init` is an explicit initialization; `index` does its own scan.
    if cmd != "mcp" and cmd != "init":
        _auto_init(auto_index=(cmd != "index"))
    dispatch = {
        "init": cmd_init,
        "index": cmd_index,
        "recall": cmd_recall,
        "skill": cmd_skill,
        "task": cmd_task,
        "events": cmd_events,
        "vigilance": cmd_vigilance,
        "impact": cmd_impact,
        "suggest": cmd_suggest,
        "bug_scan": cmd_bug_scan,
        "team": cmd_team,
        "sync": cmd_sync,
        "cache": cmd_cache,
        "graph": cmd_graph,
        "revision": cmd_revision,
        "mcp": cmd_mcp,
        "cli": cmd_cli,
        "help": lambda a: (print_help(), 0)[1],
        "--help": lambda a: (print_help(), 0)[1],
        "-h": lambda a: (print_help(), 0)[1],
    }
    if cmd not in dispatch:
        print(f"Unknown command: {cmd}")
        print_help()
        return 1
    return dispatch[cmd](sys.argv)


if __name__ == "__main__":
    sys.exit(main())
