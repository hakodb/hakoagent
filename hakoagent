_SYNC_CONFIG_PATH = None
_SYNC_CONFIG = None
_NET_SYNCER = None  # Cached HK_NetSyncer handle


def _sync_config_path():
    """Return the path to the sync config JSON file."""
    global _SYNC_CONFIG_PATH
    if _SYNC_CONFIG_PATH is None:
        _SYNC_CONFIG_PATH = HAKO_DIR / "sync" / "sync.json"
    return _SYNC_CONFIG_PATH


def _load_sync_config():
    """Load sync config from disk, or return defaults."""
    global _SYNC_CONFIG
    if _SYNC_CONFIG is not None:
        return _SYNC_CONFIG
    path = _sync_config_path()
    if path.exists():
        try:
            import json as _json
            _SYNC_CONFIG = _json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            _SYNC_CONFIG = None
    if _SYNC_CONFIG is None:
        _SYNC_CONFIG = {
            "enabled": False,
            "type": "mesh",
            "room_key": None,
            "room_name": None,
            "port": 9876,
            "server_url": None,
            "api_token": None,
            "replication_collections": None,
            "local_only_collections": [],
            "started_at": None,
            "actor": None,
        }
    return _SYNC_CONFIG


def _save_sync_config(config):
    """Save sync config to disk."""
    _ensure_dirs()
    sync_dir = _sync_config_path().parent
    sync_dir.mkdir(parents=True, exist_ok=True)
    _atomic_write_text(_sync_config_path(), json.dumps(config, indent=2, ensure_ascii=False))
    global _SYNC_CONFIG
    _SYNC_CONFIG = config


def _is_sync_enabled():
    """Check if sync is currently enabled."""
    return _load_sync_config().get("enabled", False)


def _get_net_syncer():
    """Get or create the cached HK_NetSyncer handle."""
    global _NET_SYNCER
    if _NET_SYNCER is not None:
        return _NET_SYNCER
    return None


def _set_net_syncer(syncer):
    """Cache the HK_NetSyncer handle."""
    global _NET_SYNCER
    _NET_SYNCER = syncer


def _free_net_syncer(cloud=False):
    """Release the cached syncer handle.

    The mesh net syncer is engine-owned (nothing to free on the C side);
    the cloud sync handle is ours (Box::into_raw), so stop + free it.
    `cloud` must be captured before the caller clears the config type.
    """
    global _NET_SYNCER
    if _NET_SYNCER is not None:
        if cloud:
            try:
                hk_cloud_sync_stop(_NET_SYNCER)
                hk_cloud_sync_free(_NET_SYNCER)
            except Exception:
                pass  # engine may already be closed
        _NET_SYNCER = None


