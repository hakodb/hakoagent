def _spawn_background_index():
    """Start `hakoagent index` in a detached subprocess.

    Used by the MCP server so a cold project does not block the `initialize`
    handshake while the whole repository is indexed. All output is discarded
    so the child can never write non-JSON bytes to the parent's stdout.
    """
    try:
        import subprocess
        env = dict(os.environ)
        env["HAKOAGENT_SKIP_AUTO_INIT"] = "1"
        env["HAKOAGENT_NO_SESSION"] = "1"
        script = os.path.abspath(__file__)
        python = sys.executable or "python3"
        with open(os.devnull, "wb") as devnull:
            subprocess.Popen(
                [python, script, "index"],
                stdin=devnull,
                stdout=devnull,
                stderr=devnull,
                close_fds=True,
                env=env,
                start_new_session=True,
            )
    except Exception:
        # Never let background indexing break the server.
        pass


def _auto_init(quiet=False, index_in_background=False, auto_index=True):
    """Auto-initialize HakoDB if not already initialized.
    Called at the start of every command so the agent doesn't need
    to manually run 'hakoagent init' first.

    `quiet` suppresses stdout (required in MCP mode: stdout is the
    JSON-RPC channel). `index_in_background` keeps cold-start indexing
    from blocking the MCP handshake.
    """
    if os.environ.get("HAKOAGENT_SKIP_AUTO_INIT") == "1":
        return
    events_dir = MEMORY_DIR / "events"
    initialized = False
    if events_dir.exists():
        for d in events_dir.iterdir():
            if d.is_file() and d.suffix == ".json":
                try:
                    doc = json.loads(d.read_text(encoding="utf-8"))
                    if doc.get("action") == "init":
                        initialized = True
                        break
                except (json.JSONDecodeError, OSError):
                    continue
    if not initialized:
        cmd_init(["init", "--db", "./.hakoagent/hakoagent.db", "--collections", "all"],
                 quiet=quiet)

    # Auto-index on startup if code_index is empty (cold project)
    ci_dir = MEMORY_DIR / "code_index"
    if auto_index and ci_dir.exists() and not any(ci_dir.glob("*.json")):
        if index_in_background:
            _spawn_background_index()
        else:
            cmd_index(["index"], quiet=True)



