    fn = lib.hk_engine_free
    fn.argtypes = [c_void_p]
    fn.restype = None
    fn(engine)


_hako_engine = None


def _find_hako_dir():
    """Find .hakoagent directory by searching upward from CWD and script dir."""
    # Search upward from CWD
    cur = Path.cwd()
    while True:
        candidate = cur / ".hakoagent"
        if candidate.exists():
            return candidate
        if cur.parent == cur:
            break
        cur = cur.parent

    # Search upward from script directory
    script_dir = Path(__file__).resolve().parent
    cur = script_dir
    while True:
        candidate = cur / ".hakoagent"
        if candidate.exists():
            return candidate
        if cur.parent == cur:
            break
        cur = cur.parent

    # Fall back to ~/.hakoagent
    hako_dir = Path.home() / ".hakoagent"
    if hako_dir.exists():
        return hako_dir

    # Create .hakoagent in CWD as last resort
    hako_dir = Path.cwd() / ".hakoagent"
    hako_dir.mkdir(parents=True, exist_ok=True)
    return hako_dir


def _get_engine(db_path=None):
    """Get or create the HakoDB engine handle.

    HAKO_DIR is the single source of truth for where project data lives.
    Do not fall back to upward discovery here: JSON storage and the hakodb
    engine must always point at the same directory, otherwise reads and
    writes silently diverge (and can leak another project's data).
    """
    global _hako_engine
    if _hako_engine is None:
        lib = _hakodb_lib_load()
        if lib is None:
            return None
        fn = lib.hk_engine_open
        fn.argtypes = [c_char_p]
        fn.restype = c_void_p
        db_path = db_path or str(HAKO_DIR)
        engine = fn(db_path.encode())
        if engine:
            _hako_engine = engine
    return _hako_engine


def _set_engine(engine):
    """Set the cached HakoDB engine handle."""
    global _hako_engine
    _hako_engine = engine


def hk_engine_put(engine, collection, doc_id, content_json):
    """Insert a JSON document into a collection via hk_engine_insert_json."""
    lib = _hakodb_lib_load()
    if lib is None or engine is None:
        return False
    fn = lib.hk_engine_insert_json
    fn.argtypes = [c_void_p, c_char_p, c_char_p, c_char_p]
    fn.restype = c_int
    rc = fn(engine, collection.encode(), doc_id.encode(), content_json.encode())
    return rc == 0


def hk_engine_get(engine, collection, doc_id):
    """Get a JSON document from a collection via hk_engine_get_json."""
    from ctypes import string_at
    lib = _hakodb_lib_load()
    if lib is None:
        return None
    fn = lib.hk_engine_get_json
    fn.argtypes = [c_void_p, c_char_p, c_char_p]
    fn.restype = c_void_p
    ptr = fn(engine, collection.encode(), doc_id.encode())
    if ptr:
        val = string_at(ptr).decode()
        # Free the C string returned by hakodb
        fn_free = lib.hk_string_free
        fn_free.argtypes = [c_void_p]
        fn_free.restype = None
        fn_free(ptr)
        return val
    return None


def hk_engine_delete(engine, collection, doc_id):
    lib = _hakodb_lib_load()
    if lib is None:
        return False
    fn = lib.hk_engine_delete
    fn.argtypes = [c_void_p, c_char_p, c_char_p]
    fn.restype = c_int
    rc = fn(engine, collection.encode(), doc_id.encode())
    return rc == 0


