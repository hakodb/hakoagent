# Tool: recall
def _mcp_recall(args):
    query = args.get("query", "")
    limit = int(args.get("limit", 5))
    actor_filter = args.get("actor")
    terms = _tokenize(query)
    expanded = _expand_query(terms)
    if expanded:
        terms = terms + expanded

    cached = cache_get_internal(query)
    if cached:
        return {
            "query": query,
            "result": "cache_hit",
            "summary": cached.get("summary", ""),
            "collections": ["context_cache"],
        }

    _inc_cache_miss()
    collections = ["code_index", "events", "decisions", "findings", "skills"]
    results = []
    for coll in collections:
        for score, doc_id, doc in _vector_search_collection(coll, terms, limit):
            if actor_filter is not None and doc.get("actor") != actor_filter:
                continue
            results.append({
                "collection": coll,
                "doc_id": doc_id,
                "score": round(score, 3),
                "summary": _summarize_doc(doc),
            })
    results.sort(key=lambda x: x["score"], reverse=True)
    results = results[:limit]

    summary = "; ".join(
        [f"{r['collection']}/{r['doc_id']} :: {r['summary']}" for r in results]
    ) if results else "no matching context found"

    skill_results = _vector_search_collection("skills", terms, limit=3)
    recommended_skills = [
        {"name": doc.get("name", doc_id), "score": round(score, 3)}
        for score, doc_id, doc in skill_results
    ]

    cache_put_internal(query, summary, DEFAULT_TTL)
    log_event(SESSION_ID, "hakoagent", "recall_miss", query, "info",
              {"results": len(results), "collections": collections})

    return {
        "query": query,
        "result": "cache_miss",
        "summary": summary,
        "results": results,
        "recommended_skills": recommended_skills,
        "collections": collections,
    }

# Tool: index
def _mcp_index(args):
    _ensure_dirs()
    scan_root = ROOT
    ignore_dirs = {".git", "target", "__pycache__", ".hakoagent", "node_modules", ".venv", "build", "dist"}
    ignore_files = {".pyc", ".pyo", ".so", ".dylib", ".dll", ".o", ".a"}

    files = []
    for path in scan_root.rglob("*"):
        if not path.is_file():
            continue
        parts = path.relative_to(scan_root).parts
        if any(p in ignore_dirs for p in parts):
            continue
        if path.suffix in ignore_files:
            continue
        try:
            rel = str(path.relative_to(scan_root))
        except ValueError:
            rel = str(path)
        files.append((path, rel))

    indexed = 0
    for path, rel in files:
        file_hash = _sha256_file(path)
        deps = _extract_dependencies(path)

        existing = None
        for doc_id, doc in scan_docs("code_index"):
            if doc.get("file_path") == rel:
                existing = doc_id
                break
        if existing:
            doc = load_doc("code_index", existing)
            doc["file_hash"] = file_hash
            doc["last_indexed_at"] = now_iso()
            doc["dependinsi"] = deps
            save_doc("code_index", existing, doc)
        else:
            entry_id = f"code_index_{uuid.uuid4().hex[:12]}"
            doc = {
                "entry_id": entry_id,
                "file_path": rel,
                "symbol_name": path.stem,
                "symbol_type": "file",
                "dependinsi": deps,
                "line_number": 0,
                "last_indexed_at": now_iso(),
                "file_hash": file_hash,
            }
            save_doc("code_index", entry_id, doc)
        indexed += 1

    by_symbol = {}
    by_path = {}
    by_entry_id = {}
    for doc_id, doc in scan_docs("code_index"):
        by_symbol[doc.get("symbol_name", "")] = doc_id
        by_path[doc.get("file_path", "")] = doc_id
        by_entry_id[doc.get("entry_id", "")] = doc_id

    resolved_count = 0
    for doc_id, doc in scan_docs("code_index"):
        raw_deps = doc.get("dependinsi", [])
        resolved = []
        for dep in raw_deps:
            target = None
            if dep in by_entry_id:
                target = dep
            elif dep in by_symbol:
                target = by_symbol[dep]
            elif dep in by_path:
                target = by_path[dep]
            for ext in (".py", ".rs", ".js", ".ts", ".go"):
                if dep + ext in by_path:
                    target = by_path[dep + ext]
                    break
            if target and target != doc_id:
                resolved.append(target)
        if resolved != raw_deps:
            doc["dependinsi"] = resolved
            save_doc("code_index", doc_id, doc)
            resolved_count += 1

    log_event(SESSION_ID, "hakoagent", "index", str(scan_root), "info",
              {"indexed": indexed, "with_deps": resolved_count})

    return {
        "indexed": indexed,
        "with_deps": resolved_count,
        "message": f"Indexed {indexed} file(s) into code_index collection.",
    }

# Tool: vigilance
def _mcp_vigilance(args):
    modified_without_test = 0
    total_modified = 0
    total_with_test = 0
    for doc_id, doc in scan_docs("code_index"):
        fp = doc.get("file_path", "")
        if fp.endswith((".py", ".rs")):
            total_modified += 1
            base = fp.rsplit(".", 1)[0]
            test_exists = any(
                d.get("file_path", "").startswith(base) and "test" in d.get("file_path", "").lower()
                for _, d in scan_docs("code_index")
            )
            if test_exists:
                total_with_test += 1
            else:
                modified_without_test += 1

    todo_count = 0
    for path in ROOT.rglob("*"):
        if not path.is_file():
            continue
        parts = path.relative_to(ROOT).parts
        if any(p in (".git", "target", "__pycache__", ".hakoagent", "node_modules") for p in parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except (OSError, UnicodeDecodeError):
            continue
        for marker in ("TODO", "FIXME", "XXX"):
            todo_count += text.count(marker)

    return {
        "modified_without_test": modified_without_test,
        "total_modified": total_modified,
        "total_with_test": total_with_test,
        "todo_fixme_xxx_count": todo_count,
    }

# Tool: bug_scan
def _mcp_bug_scan(args):
    patterns = {
        "bare_except": r"^\s*except\s*:",
        "bare_raise": r"^\s*raise\s*$",
        "print_debug": r"\bprint\s*\(",
        "hardcoded_secret": r"(?i)(password|secret|api_key|token)\s*=\s*['\"][^'\"]{4,}",
        "todo_in_code": r"(TODO|FIXME|XXX|HACK)",
        "eval_usage": r"\beval\s*\(",
        "exec_usage": r"\bexec\s*\(",
    }
    findings = []
    total_files = 0
    for doc_id, doc in scan_docs("code_index"):
        fp = doc.get("file_path", "")
        if not fp.endswith((".py", ".rs", ".js", ".ts", ".go")):
            continue
        total_files += 1
        try:
            text = Path(fp).read_text(encoding="utf-8", errors="ignore")
        except (OSError, UnicodeDecodeError):
            continue
        for line_num, line in enumerate(text.splitlines(), 1):
            for name, pat in patterns.items():
                if re.search(pat, line):
                    findings.append({
                        "file": fp,
                        "line": line_num,
                        "pattern": name,
                        "line_content": line.strip()[:80],
                    })

    by_pattern = {}
    for f in findings:
        by_pattern.setdefault(f["pattern"], []).append(f)

    return {
        "files_scanned": total_files,
        "findings_count": len(findings),
        "findings": findings,
        "by_pattern": {k: len(v) for k, v in by_pattern.items()},
    }

# Tool: suggest
def _mcp_suggest(args):
    suggestions = []
    events = docs_by_time("events")
    recent_events = []
    for eid, doc in events[-20:]:
        action = doc.get("action", "?")
        target = doc.get("target", "?")
        if action != "?" and target != "?":
            recent_events.append((action, target))

    tasks = docs_by_time("tasks")
    recent_tasks = []
    for tid, doc in tasks[-10:]:
        title = doc.get("title", "?")
        status = doc.get("status", "?")
        if title != "?":
            recent_tasks.append((title, status))

    if any(a == "index" for a, _ in recent_events):
        suggestions.append({"cmd": "recall", "query": "codebase structure", "why": "What files and symbols were indexed?"})
        suggestions.append({"cmd": "recall", "query": "dependencies", "why": "What dependency relationships exist?"})

    if any("vigilance" in a for a, _ in recent_events):
        suggestions.append({"cmd": "recall", "query": "regression", "why": "What regressions were detected?"})
        suggestions.append({"cmd": "recall", "query": "TODO FIXME", "why": "What TODO/FIXME items exist?"})

    for title, status in recent_tasks[:3]:
        if status == "todo":
            suggestions.append({"cmd": "recall", "query": title.lower(), "why": f"Context for task: {title}"})
        if status == "done":
            suggestions.append({"cmd": "recall", "query": title.lower(), "why": f"Review completed task: {title}"})

    skills = list_docs("skills")
    if skills:
        suggestions.append({"cmd": "skill", "query": "list", "why": "Review available skills before starting work"})
        suggestions.append({"cmd": "recall", "query": "skill pattern", "why": "Find reusable skill patterns"})

    if not events:
        suggestions.append({"cmd": "recall", "query": "project overview", "why": "Get an overview of the project context"})
        suggestions.append({"cmd": "recall", "query": "constitution", "why": "Review project constitution"})

    if not suggestions:
        suggestions.append({"cmd": "recall", "query": "<any>", "why": "Run any recall query to load relevant context"})

    return {"suggestions": suggestions}

