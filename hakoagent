def _sha256_file(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ""


def _tokenize(text):
    return [t for t in text.lower().replace("_", " ").replace("-", " ").split() if t]


def _score_match(query_terms, text):
    text_l = text.lower()
    return sum(1 for t in query_terms if t in text_l)


# PONYTAIL: vector search uses stdlib TF-IDF + cosine similarity, no external ML deps.
# Ceiling: no semantic embeddings, no contextual understanding, vocab-limited.
# Upgrade path: replace with sentence-transformers + hnswlib/faiss when semantic search needed.
import math
from collections import Counter


def _tfidf_vectorize(docs):
    """Build TF-IDF vectors from list of (doc_id, text) tuples. Stdlib only."""
    doc_freq = Counter()
    doc_terms = {}
    for doc_id, text in docs:
        terms = _tokenize(text)
        term_counts = Counter(terms)
        doc_terms[doc_id] = term_counts
        for term in set(terms):
            doc_freq[term] += 1

    n_docs = len(docs)
    vectors = {}
    for doc_id, term_counts in doc_terms.items():
        vec = {}
        doc_len = sum(term_counts.values()) or 1
        for term, count in term_counts.items():
            tf = count / doc_len
            idf = math.log(1 + n_docs / max(1, doc_freq[term]))
            vec[term] = tf * idf
        vectors[doc_id] = vec
    return vectors


def _cosine_similarity(vec_a, vec_b):
    """Cosine similarity between two sparse vectors (dict term->weight)."""
    if not vec_a or not vec_b:
        return 0.0
    dot = sum(vec_a.get(t, 0) * vec_b.get(t, 0) for t in vec_a)
    norm_a = math.sqrt(sum(v * v for v in vec_a.values()))
    norm_b = math.sqrt(sum(v * v for v in vec_b.values()))
    if norm_a == 0 or norm_b == 0:
        return 0.0
    return dot / (norm_a * norm_b)


def _vectorize_query(query_terms, vectors):
    """Build a query vector using existing IDF from doc vectors."""
    if not vectors:
        return {}
    # Estimate IDF from existing vectors: terms present in few docs have higher weight
    n_docs = len(vectors)
    doc_freq = Counter()
    for vec in vectors.values():
        for term in vec:
            doc_freq[term] += 1
    query_counts = Counter(query_terms)
    query_len = sum(query_counts.values()) or 1
    vec = {}
    for term, count in query_counts.items():
        tf = count / query_len
        idf = math.log(1 + n_docs / max(1, doc_freq.get(term, 0)))
        vec[term] = tf * idf
    return vec


def _expand_query(query_terms):
    """Expand query terms with related terms from code_index symbols.
    Ponytail: simple keyword co-occurrence, no ML model.
    Ceiling: limited to terms already in code_index.
    Upgrade path: replace with embedding-based expansion."""
    related = set()
    for doc_id, doc in scan_docs("code_index"):
        sym = doc.get("symbol_name", "").lower()
        fp = doc.get("file_path", "").lower()
        for term in query_terms:
            if term in sym or term in fp:
                for t in _tokenize(sym + " " + fp):
                    if t != term and len(t) > 2:
                        related.add(t)
    return list(related)[:5]


def _extract_dependencies(path):
    """Extract import/module dependency names from a source file."""
    deps = []
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")
    except (OSError, UnicodeDecodeError):
        return deps

    for line in text.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        # Python: import X, from X import ...
        m = re.match(r'^import\s+([\w.]+)', stripped)
        if m:
            deps.append(m.group(1).split('.')[0])
            continue
        m = re.match(r'^from\s+([\w.]+)\s+import', stripped)
        if m:
            deps.append(m.group(1).split('.')[0])
            continue
        # Rust: use X; use X::Y;
        m = re.match(r'^use\s+([\w:]+);', stripped)
        if m:
            deps.append(m.group(1).split('::')[0])
            continue
        # JS/TS: import ... from 'X', require('X')
        m = re.match(r"^import\s+.*\s+from\s+['\"]([^'\"]+)['\"]", stripped)
        if m:
            deps.append(m.group(1))
            continue
        m = re.match(r"^const\s+.*=\s*require\(['\"]([^'\"]+)['\"]\)", stripped)
        if m:
            deps.append(m.group(1))
            continue
        # C/C++: #include "X" or #include <X>
        m = re.match(r'^#include\s+["<]([^">]+)[">]', stripped)
        if m:
            deps.append(m.group(1))
            continue
    return deps


def _format_table(headers, rows):
    """Render rows as an ASCII table. Returns a string."""
    if not rows:
        return ""
    widths = [len(str(h)) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(str(cell)))
    lines = []
    lines.append(" | ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
    lines.append("-+-".join("-" * w for w in widths))
    for row in rows:
        lines.append(" | ".join(str(c).ljust(widths[i]) for i, c in enumerate(row)))
    return "\n".join(lines)


def _parse_format(args):
    """Extract --format <fmt> from args. Returns (fmt, remaining_args)."""
    fmt = "text"
    remaining = []
    i = 0
    while i < len(args):
        if args[i] == "--format" and i + 1 < len(args):
            fmt = args[i + 1]
            i += 2
        else:
            remaining.append(args[i])
            i += 1
    return fmt, remaining


