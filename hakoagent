def _cmd_sync_enable(args):
    """Enable hakodb synchronization (mesh or cloud)."""
    sync_type = "mesh"
    room_key = None
    room_name = None
    port = 9876
    server_url = None
    api_token = None
    replication_collections = None
    local_only_collections = None
    actor = "agent"

    i = 3
    while i < len(args):
        if args[i] == "--type" and i + 1 < len(args):
            sync_type = args[i + 1]
            if sync_type not in ("mesh", "cloud"):
                print(f"Error: --type must be 'mesh' or 'cloud', got '{sync_type}'")
                return 1
            i += 2
        elif args[i] == "--room-key" and i + 1 < len(args):
            room_key = args[i + 1]
            i += 2
        elif args[i] == "--room-name" and i + 1 < len(args):
            room_name = args[i + 1]
            i += 2
        elif args[i] == "--port" and i + 1 < len(args):
            try:
                port = int(args[i + 1])
            except ValueError:
                print(f"Error: --port must be an integer, got '{args[i + 1]}'")
                return 1
            i += 2
        elif args[i] == "--server" and i + 1 < len(args):
            server_url = args[i + 1]
            i += 2
        elif args[i] == "--token" and i + 1 < len(args):
            api_token = args[i + 1]
            i += 2
        elif args[i] == "--collections" and i + 1 < len(args):
            replication_collections = [c.strip() for c in args[i + 1].split(",") if c.strip()]
            i += 2
        elif args[i] == "--local-only" and i + 1 < len(args):
            local_only_collections = [c.strip() for c in args[i + 1].split(",") if c.strip()]
            i += 2
        elif args[i] == "--actor" and i + 1 < len(args):
            actor = args[i + 1]
            i += 2
        else:
            i += 1

    if sync_type == "mesh" and not room_key:
        print("Error: --room-key is required for mesh sync")
        return 1
    if sync_type == "cloud" and (not server_url or not api_token):
        print("Error: --server and --token are required for cloud sync")
        return 1

    # Load current config
    config = _load_sync_config()
    config["enabled"] = True
    config["type"] = sync_type
    config["room_key"] = room_key
    config["room_name"] = room_name
    config["port"] = port
    config["server_url"] = server_url
    config["api_token"] = api_token
    config["replication_collections"] = replication_collections
    config["local_only_collections"] = local_only_collections or []
    config["started_at"] = now_iso()
    config["actor"] = actor

    # Save config
    _save_sync_config(config)

    # Open engine with config if sync should be active
    config_obj = hk_config_new()
    if config_obj:
        if replication_collections:
            hk_config_set_replication_collections(config_obj, json.dumps(replication_collections))
        if local_only_collections:
            hk_config_set_sync_excluded(config_obj, json.dumps(local_only_collections))

    # For mesh sync, start net syncer
    syncer = None
    if sync_type == "mesh":
        engine = _get_engine()
        if engine:
            syncer = hk_net_syncer_new(engine, "hakoagent", room_key or "")
            if syncer:
                hk_net_syncer_set_discovery(syncer, 2)  # mDNS + UDP broadcast
                rc = hk_net_syncer_start(syncer, port)
                if rc == 0:
                    _set_net_syncer(syncer)
                else:
                    print(f"Warning: net syncer start returned {rc}")

    # For cloud sync, create a room-bound cloud CLIENT (hakodb 0.20 ABI)
    # and connect it to the hub's sync listener.
    elif sync_type == "cloud":
        engine = _get_engine()
        if engine:
            name = room_name or room_key or "default"
            cloud_syncer = hk_cloud_sync_client_new(
                engine,
                config.get("actor") or "hakoagent",
                name,
                room_key or "",
                api_token or "",
            )
            if cloud_syncer:
                rc = hk_cloud_sync_start(cloud_syncer, server_url or "")
                if rc == 0:
                    _set_net_syncer(cloud_syncer)
                else:
                    hk_cloud_sync_free(cloud_syncer)
                    print(f"Warning: cloud sync start returned {rc}. "
                          "Config saved but not connected.")
            else:
                print("Warning: cloud sync client could not be created "
                      "(native lib without cloud-sync support?). "
                      "Config saved but cloud sync not active.")
        else:
            print("Warning: engine unavailable; cloud sync config saved.")

    print(json.dumps({
        "enabled": True,
        "type": sync_type,
        "room_key": room_key,
        "room_name": room_name,
        "port": port,
        "server_url": server_url,
        "api_token": "***" if api_token else None,
        "replication_collections": replication_collections if replication_collections else "all",
        "local_only_collections": local_only_collections or [],
        "started_at": config["started_at"],
        "actor": actor,
        "message": f"Sync enabled in {sync_type} mode"
    }, indent=2))
    return 0


def _cmd_sync_disable(args):
    """Disable synchronization."""
    config = _load_sync_config()
    was_cloud = config.get("type") == "cloud"
    config["enabled"] = False
    config["type"] = None
    config["started_at"] = None
    _save_sync_config(config)

    # Free net syncer
    _free_net_syncer(cloud=was_cloud)

    print(json.dumps({
        "enabled": False,
        "type": None,
        "message": "Sync disabled"
    }, indent=2))
    return 0


def _cmd_sync_status(args):
    """Show sync configuration and peer status."""
    tier = "verify"
    i = 3
    while i < len(args):
        if args[i] == "--tier" and i + 1 < len(args):
            tier = args[i + 1]
            i += 2
        else:
            i += 1

    config = _load_sync_config()
    result = {
        "enabled": config.get("enabled", False),
        "type": config.get("type"),
        "room_key": config.get("room_key"),
        "port": config.get("port"),
        "server_url": config.get("server_url"),
        "api_token": "***" if config.get("api_token") else None,
        "replication_collections": config.get("replication_collections") or "all",
        "local_only_collections": config.get("local_only_collections") or [],
        "started_at": config.get("started_at"),
        "actor": config.get("actor"),
        "tier": tier,
        "peers": [],
        "pending_changes": 0,
    }

    # Get syncer status if available. Cloud and net syncer are distinct
    # opaque handles - never pass one where the other is expected.
    syncer = _get_net_syncer()
    if syncer:
        try:
            if config.get("type") == "cloud":
                status_str = hk_cloud_sync_status(syncer)
            else:
                status_str = hk_net_syncer_status(syncer)
            if status_str:
                try:
                    status_json = json.loads(status_str)
                    result["syncer_status"] = status_json
                except json.JSONDecodeError:
                    result["syncer_status_raw"] = status_str
        except Exception:
            pass

    print(json.dumps(result, indent=2))
    return 0


def _cmd_sync_sync_now(args):
    """Manually trigger catch-up sync with peers."""
    if not _is_sync_enabled():
        print("Sync is not enabled. Run 'hakoagent sync enable' first.")
        return 1

    syncer = _get_net_syncer()
    if not syncer:
        # No active syncer (e.g., hk_net_syncer_start returned error in this build)
        # Report 0 changes synced since net syncer handles continuous replication
        print(json.dumps({
            "changes_synced": 0,
            "peers_contacted": 0,
            "sync_duration_ms": 0,
            "errors": [],
            "message": "No active syncer; net syncer handles continuous replication when available"
        }, indent=2))
        return 0

    # Trigger sync - net syncer handles this automatically
    try:
        status_str = hk_net_syncer_status(syncer)
        if status_str:
            try:
                status_json = json.loads(status_str)
                peers = status_json.get("peers", [])
                print(json.dumps({
                    "changes_synced": 0,
                    "peers_contacted": len(peers),
                    "sync_duration_ms": 0,
                    "errors": [],
                    "message": "Sync triggered (net syncer handles continuous replication)"
                }, indent=2))
            except json.JSONDecodeError:
                print(json.dumps({
                    "changes_synced": 0,
                    "peers_contacted": 0,
                    "sync_duration_ms": 0,
                    "errors": [],
                    "message": "Sync triggered"
                }, indent=2))
        else:
            print(json.dumps({
                "changes_synced": 0,
                "peers_contacted": 0,
                "sync_duration_ms": 0,
                "errors": [],
                "message": "Sync triggered"
            }, indent=2))
    except Exception as e:
        print(json.dumps({
            "changes_synced": 0,
            "peers_contacted": 0,
            "sync_duration_ms": 0,
            "errors": [str(e)],
        }, indent=2))
    return 0


def _cmd_sync_backup(args):
    """Backup the synced database."""
    if len(args) < 4:
        print("Usage: hakoagent sync backup <path>")
        return 1
    backup_path = args[3]

    engine = _get_engine()
    if not engine:
        # Try opening with config
        config_obj = hk_config_new()
        if config_obj:
            config = _load_sync_config()
            if config.get("replication_collections"):
                hk_config_set_replication_collections(
                    config_obj, json.dumps(config["replication_collections"]))
            if config.get("local_only_collections"):
                hk_config_set_sync_excluded(
                    config_obj, json.dumps(config["local_only_collections"]))
            engine = hk_engine_open_with_config(str(MEMORY_DIR), config_obj)
            if engine:
                _set_engine(engine)

    if not engine:
        print("Error: No engine available")
        return 1

    rc = hk_engine_backup(engine, backup_path)
    if rc == 0:
        print(json.dumps({
            "backup_path": backup_path,
            "status": "success",
            "message": "Database backed up successfully"
        }, indent=2))
    else:
        print(json.dumps({
            "backup_path": backup_path,
            "status": "failed",
            "message": f"Backup failed with code {rc}"
        }, indent=2))
    return 0


