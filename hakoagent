        # Mark current as deprecated, create refined version
        target_doc["status"] = "deprecated"
        target_doc["deprecated_at"] = now_iso()
        target_doc["deprecated_reason"] = "refined into newer version"
        save_doc("skills", target_sid, target_doc)

        new_sid = f"skill_{uuid.uuid4().hex[:12]}"
        new_ver = (target_doc.get("version", 1) or 1) + 1
        # Trim summary to context limit (~300 chars)
