def cmd_index(args, quiet=False):
    """Scan codebase and populate code_index with symbol/dependency entries."""
    _ensure_dirs()
    scan_root = ROOT
    ignore_dirs = {".git", "target", "__pycache__", ".hakoagent", "node_modules", ".venv", "build", "dist"}
    ignore_files = {".pyc", ".pyo", ".so", ".dylib", ".dll", ".o", ".a"}

    files = []
    for path in scan_root.rglob("*"):
        if not path.is_file():
            continue
        parts = path.relative_to(scan_root).parts
        if any(p in ignore_dirs for p in parts):
            continue
        if path.suffix in ignore_files:
            continue
        try:
            rel = str(path.relative_to(scan_root))
        except ValueError:
            rel = str(path)
        files.append((path, rel))

    # First pass: index changed/new files only. Rewriting every file on every
    # run used to create one revision per file per index.
    existing_by_path = {}
    for doc_id, existing_doc in scan_docs("code_index"):
        existing_by_path.setdefault(existing_doc.get("file_path", ""), (doc_id, existing_doc))

    indexed = 0
    for path, rel in files:
        file_hash = _sha256_file(path)
        entry = existing_by_path.get(rel)
        if entry:
            existing, doc = entry
            if doc.get("file_hash") == file_hash:
                continue  # unchanged since last index
            doc = dict(doc)
            doc["file_hash"] = file_hash
            doc["last_indexed_at"] = now_iso()
            doc["dependinsi"] = _extract_dependencies(path)
            save_doc("code_index", existing, doc)
            existing_by_path[rel] = (existing, doc)
        else:
            deps = _extract_dependencies(path)
            entry_id = f"code_index_{uuid.uuid4().hex[:12]}"
            doc = {
                "entry_id": entry_id,
                "file_path": rel,
                "symbol_name": path.stem,
                "symbol_type": "file",
                "dependinsi": deps,
                "line_number": 0,
                "last_indexed_at": now_iso(),
                "file_hash": file_hash,
            }
            save_doc("code_index", entry_id, doc)
            existing_by_path[rel] = (entry_id, doc)
        indexed += 1

    # Second pass: resolve dependency names to entry IDs
    by_symbol = {}
    by_path = {}
    by_entry_id = {}
    for doc_id, doc in scan_docs("code_index"):
        by_symbol[doc.get("symbol_name", "")] = doc_id
        by_path[doc.get("file_path", "")] = doc_id
        by_entry_id[doc.get("entry_id", "")] = doc_id

    resolved_count = 0
    for doc_id, doc in scan_docs("code_index"):
        raw_deps = doc.get("dependinsi", [])
        resolved = []
        for dep in raw_deps:
            target = None
            # Already an entry_id (from previous index run): keep as-is
            if dep in by_entry_id:
                target = dep
            elif dep in by_symbol:
                target = by_symbol[dep]
            elif dep in by_path:
                target = by_path[dep]
            # Try with common extensions
            for ext in (".py", ".rs", ".js", ".ts", ".go"):
                if dep + ext in by_path:
                    target = by_path[dep + ext]
                    break
            if target and target != doc_id:
                resolved.append(target)
        if resolved != raw_deps:
            doc["dependinsi"] = resolved
            save_doc("code_index", doc_id, doc)
            resolved_count += 1

    log_event(SESSION_ID, "hakoagent", "index", str(scan_root), "info", {"indexed": indexed, "with_deps": resolved_count})
    if not quiet:
        print(f"Indexed {indexed} file(s) into code_index collection.")
        if resolved_count:
            print(f"  {resolved_count} file(s) with dependencies resolved.")
        print()
        print("  Tip: Run 'hakoagent recall <query>' to search indexed code.")
        print("  Tip: Run 'hakoagent suggest' for recall ideas based on recent activity.")
    return 0


def _index_if_codebase_changed():
    """Re-index codebase only if the working tree has changes.
    Uses `git status --porcelain` so new (untracked) files also trigger a
    re-index. Skips silently when git is unavailable or nothing changed."""
    try:
        import subprocess
        result = subprocess.run(
            ["git", "status", "--porcelain"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
        )
        if result.returncode != 0:
            return
        changed = []
        for line in result.stdout.decode("utf-8", "replace").splitlines():
            if not line.strip():
                continue
            path = line[3:].strip()
            if " -> " in path:  # rename/copy: keep the destination
                path = path.split(" -> ", 1)[1]
            path = path.strip('"')
            if path.startswith(".hakoagent/") or "/.hakoagent/" in path:
                continue
            changed.append(path)
        if not changed:
            return  # No codebase changes — skip re-index
    except (OSError, subprocess.TimeoutExpired, FileNotFoundError):
        return  # Git not available — skip silently

    try:
        cmd_index(["index"], quiet=True)
    except Exception:
        pass  # Never let index failure break task completion

def _vector_search_collection(collection, query_terms, limit=5):
    """Vector search (TF-IDF + cosine) across any collection. Returns (score, doc_id, doc)."""
    docs = [(doc_id, " ".join(str(doc.get(k, "")) for k in doc.keys()))
            for doc_id, doc in scan_docs(collection)]
    if not docs:
        return []
    doc_vectors = _tfidf_vectorize(docs)
    query_vec = _vectorize_query(query_terms, doc_vectors)
    results = []
    for doc_id, doc in scan_docs(collection):
        score = _cosine_similarity(query_vec, doc_vectors.get(doc_id, {}))
        if score > 0:
            results.append((score, doc_id, doc))
    results.sort(key=lambda x: x[0], reverse=True)
    return results[:limit]


def _summarize_doc(doc):
    fields = []
    for k in ("file_path", "symbol_name", "symbol_type", "action", "target", "title", "name", "description"):
        v = doc.get(k)
        if v:
            fields.append(f"{k}={v}")
    return " | ".join(fields) if fields else str(doc)[:100]


def cmd_recall(args):
    if len(args) < 3:
        print("Usage: hakoagent recall <query> [--limit N] [--actor <actor>]")
        return 1
    limit = 5
    actor_filter = None
    query_parts = []
    i = 2
    while i < len(args):
        if args[i] == "--limit" and i + 1 < len(args):
            try:
                limit = int(args[i + 1])
            except ValueError:
                pass
            i += 2
        elif args[i] == "--actor" and i + 1 < len(args):
            actor_filter = args[i + 1]
            i += 2
        else:
            query_parts.append(args[i])
            i += 1
    query = " ".join(query_parts)
    terms = _tokenize(query)
    # Query expansion: add related terms from code_index symbols
    expanded = _expand_query(terms)
    if expanded:
        terms = terms + expanded
        print(f"  Query expanded with: {', '.join(expanded)}")


    # First check context cache (TTL-valid)
    cached = cache_get_internal(query)
    if cached:
        print(f"Query: {query}")
        print("  Result: cache hit (TTL-valid)")
        print(f"  Summary: {cached.get('summary','')}")
        log_event(SESSION_ID, "hakoagent", "recall_cache_hit", query, "info", {})
        _inc_cache_hit()
        return 0

    _inc_cache_miss()

    # Vector search across all memory collections
    collections = ["code_index", "events", "decisions", "findings", "skills"]
    results = []
    for coll in collections:
        for score, doc_id, doc in _vector_search_collection(coll, terms, limit):
            # Apply actor filter if specified
            if actor_filter is not None and doc.get("actor") != actor_filter:
                continue
            results.append((score, coll, doc_id, doc))
    results.sort(key=lambda x: x[0], reverse=True)
    results = results[:limit]

    summary_parts = []
    for score, coll, doc_id, doc in results:
        actor_tag = f" [{doc.get('actor', '?')}]" if doc.get('actor') else ""
        summary_parts.append(f"{coll}/{doc_id}{actor_tag} :: {_summarize_doc(doc)}")
    summary = "; ".join(summary_parts) if summary_parts else "no matching context found"

    print(f"Query: {query}")
    if actor_filter:
        print(f"  Actor filter: {actor_filter}")
    print("Vector search (TF-IDF + cosine) across all memory collections.")
    if results:
        print("  Results:")
        for score, coll, doc_id, doc in results:
            print(f"    [{coll}] {doc_id} :: {_summarize_doc(doc)}  (score={score:.3f})")
    else:
        print("  No relevant context found.")

    # Skill recommendation: vector match query against skill descriptions
    skill_results = _vector_search_collection("skills", terms, limit=3)
    if skill_results:
        print("  Recommended skills:")
        for score, doc_id, doc in skill_results:
            print(f"    - {doc.get('name', doc_id)} (score={score:.3f})")

    # Store in cache
    cache_put_internal(query, summary, DEFAULT_TTL)
    log_event(SESSION_ID, "hakoagent", "recall_miss", query, "info", {"results": len(results), "collections": collections})
    return 0


def _impact_analysis(nodes, adj, rev_adj, target_node):
    """Impact analysis: compute blast radius and dependencies for a node."""
    # Forward: what does target depend on? (reverse traversal: rev_adj gives incoming)
    # dependents = who depends on target = rev_adj[target] (incoming edges)
    # dependents_reverse = what target depends on = adj[target] (outgoing edges)
    direct_dependents = [n for n, _ in rev_adj.get(target_node, [])]
    direct_deps = [n for n, _ in adj.get(target_node, [])]

    # BFS outward to find transitive dependents (blast radius)
    transitive_dependents = set()
    queue = deque([target_node])
    visited = {target_node}
    while queue:
        cur = queue.popleft()
        for nbr, _ in rev_adj.get(cur, []):
            if nbr not in visited:
                visited.add(nbr)
                transitive_dependents.add(nbr)
                queue.append(nbr)

    # BFS inward to find transitive dependencies
    transitive_deps = set()
    queue = deque([target_node])
    visited2 = {target_node}
    while queue:
        cur = queue.popleft()
        for nbr, _ in adj.get(cur, []):
            if nbr not in visited2:
                visited2.add(nbr)
                transitive_deps.add(nbr)
                queue.append(nbr)

    return {
        "target_node": target_node,
        "direct_dependents": direct_dependents,
        "direct_deps": direct_deps,
        "transitive_dependents": transitive_dependents,
        "transitive_deps": transitive_deps,
    }


def cmd_impact(args):
