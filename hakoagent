# Versioned read (conflict detection)
def hk_engine_get_versioned(engine, collection, doc_id):
    """Atomic (doc, version) read. Returns (json_str, version) or (None, 0)."""
    from ctypes import string_at, c_uint64, byref
    lib = _hakodb_lib_load()
    if lib is None:
        return None, 0
    fn = lib.hk_engine_get_versioned
    fn.argtypes = [c_void_p, c_char_p, c_char_p, POINTER(c_uint64)]
    fn.restype = c_void_p
    version = c_uint64(0)
    ptr = fn(engine, collection.encode(), doc_id.encode(), byref(version))
    if ptr:
        val = string_at(ptr).decode()
        fn_free = lib.hk_string_free
        fn_free.argtypes = [c_void_p]
        fn_free.restype = None
        fn_free(ptr)
        return val, version.value
    return None, version.value


