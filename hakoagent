def _mcp_command_path():
    """Absolute path to the hakoagent-mcp executable to put in OpenCode config."""
    sibling = Path(__file__).resolve().with_name("hakoagent-mcp")
    if sibling.exists():
        return str(sibling)
    found = shutil.which("hakoagent-mcp")
    if found:
        return os.path.abspath(found)
    if Path(__file__).name in ("hakoagent", "hakoagent-mcp"):
        return os.path.abspath(__file__)
    return str(sibling)


def _mcp_project_config_path():
    """Pick the project OpenCode config file to edit.

    Returns None when only a .jsonc exists: rewriting JSONC would drop the
    user's comments, so we print a snippet instead.
    """
    for p in (ROOT / "opencode.json", ROOT / ".opencode" / "opencode.json"):
        if p.exists():
            return p
    if (ROOT / "opencode.jsonc").exists() or (ROOT / ".opencode" / "opencode.jsonc").exists():
        return None
    return ROOT / ".opencode" / "opencode.json"


def _mcp_command_config():
    """MCP `command` array for the project config.

    Windows cannot exec extensionless python scripts directly, so run
    everything through the current interpreter.
    """
    path = _mcp_command_path()
    if sys.platform == "win32":
        return [sys.executable or "python", path]
    return [path]


def _mcp_config_snippet():
    return {
        "mcp": {
            "servers": {
                "hakoagent": {
                    "type": "local",
                    "command": _mcp_command_config(),
                }
            }
        }
    }


def _mcp_write_project_config(enable):
    """Add/remove the hakoagent MCP server in the project OpenCode config.

    OpenCode V2 reads `mcp.servers.<name>`; the old V1 `mcp.<name>` shape is
    removed if present. Returns the config path, or None for manual setup.
    """
    path = _mcp_project_config_path()
    if path is None:
        print("  OpenCode JSONC config found. Add this manually:")
        print(json.dumps(_mcp_config_snippet(), indent=2))
        return None

    data = {}
    existed = path.exists()
    if existed:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (ValueError, OSError):
            print("  Could not parse %s. Add this manually:" % path)
            print(json.dumps(_mcp_config_snippet(), indent=2))
            return None

    mcp = data.get("mcp")
    if not isinstance(mcp, dict):
        mcp = {}
        if enable:
            data["mcp"] = mcp
    servers = mcp.get("servers")
    if not isinstance(servers, dict):
        servers = {}
    mcp.pop("hakoagent", None)  # drop legacy V1 entry

    if enable:
        servers["hakoagent"] = {
            "type": "local",
            "command": _mcp_command_config(),
        }
        mcp["servers"] = servers
        data["mcp"] = mcp
    else:
        servers.pop("hakoagent", None)
        if servers:
            mcp["servers"] = servers
        else:
            mcp.pop("servers", None)
        if mcp:
            data["mcp"] = mcp
        else:
            data.pop("mcp", None)

    if not data:
        # Disabling removed the only entry: drop the now-empty config file
        # instead of leaving a stale file (or creating an empty one).
        if existed and not enable:
            try:
                path.unlink()
            except OSError:
                pass
        return path

    path.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write_text(path, json.dumps(data, indent=2) + "\n")
    return path


def _mcp_enable():
    """Enable MCP for the current project."""
    _ensure_dirs()
    _mcp_marker_path().touch()
    return _mcp_write_project_config(True)


def _mcp_disable():
    """Disable MCP for the current project."""
    marker = _mcp_marker_path()
    if marker.exists():
        marker.unlink()
    return _mcp_write_project_config(False)


