def _build_graph():
    """Build adjacency from code_index dependinsi fields."""
    nodes = {}
    adj = defaultdict(list)
    rev_adj = defaultdict(list)
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc
        for dep in doc.get("dependinsi", []):
            adj[doc_id].append((dep, 1.0))
            rev_adj[dep].append((doc_id, 1.0))
    return nodes, adj, rev_adj


def _build_graph_with_edges():
    """Build adjacency from code_index + code_edges collections (typed edges)."""
    nodes = {}
    adj = defaultdict(list)
    rev_adj = defaultdict(list)
    edge_types = defaultdict(list)  # node_id -> list of edge types
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc
    for doc_id in list_docs("code_edges"):
        edge = load_doc("code_edges", doc_id)
        if edge is None:
            continue
        src = edge.get("source_id")
        tgt = edge.get("target_id")
        etype = edge.get("edge_type", "depends-on")
        conf = edge.get("confidence", 1.0)
        if src in nodes and tgt in nodes:
            adj[src].append((tgt, conf, etype))
            rev_adj[tgt].append((src, conf, etype))
            edge_types[src].append(etype)
            edge_types[tgt].append(etype)
    return nodes, adj, rev_adj, edge_types


def _graph_search_collection(label=None, name_pattern=None, min_degree=None,
                             max_degree=None, limit=50, offset=0, tier="verify"):
    """Search code_index nodes by label, name pattern, and degree (MCP search_graph adapted)."""
    nodes = {}
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc

    # Compute degrees from code_edges
    out_deg = defaultdict(int)
    in_deg = defaultdict(int)
    for doc_id in list_docs("code_edges"):
        edge = load_doc("code_edges", doc_id)
        if edge is None:
            continue
        src = edge.get("source_id")
        tgt = edge.get("target_id")
        if src in nodes:
            out_deg[src] += 1
        if tgt in nodes:
            in_deg[tgt] += 1

    results = []
    for nid, doc in nodes.items():
        # Label filter
        if label is not None and doc.get("label") != label:
            continue
        # Name pattern filter
        if name_pattern is not None:
            try:
                pat = re.compile(name_pattern)
            except re.error:
                continue
            sym = doc.get("symbol_name", "")
            fpath = doc.get("file_path", "")
            if not (pat.search(sym) or pat.search(fpath)):
                continue
        # Degree filter
        total_deg = out_deg.get(nid, 0) + in_deg.get(nid, 0)
        if min_degree is not None and total_deg < min_degree:
            continue
        if max_degree is not None and total_deg > max_degree:
            continue

        # Collect edge types for this node
        node_edge_types = set()
        for doc_id in list_docs("code_edges"):
            edge = load_doc("code_edges", doc_id)
            if edge is None:
                continue
            if edge.get("source_id") == nid or edge.get("target_id") == nid:
                et = edge.get("edge_type")
                if et:
                    node_edge_types.add(et)

        results.append({
            "entry_id": doc.get("entry_id", nid),
            "file_path": doc.get("file_path", ""),
            "symbol_name": doc.get("symbol_name", ""),
            "symbol_type": doc.get("symbol_type", ""),
            "label": doc.get("label", ""),
            "qualified_name": doc.get("qualified_name", ""),
            "line_number": doc.get("line_number", 0),
            "edge_types": sorted(node_edge_types),
            "degree": total_deg,
            "actor": doc.get("actor", ""),
        })

    # Sort by degree descending (most connected first)
    results.sort(key=lambda r: r["degree"], reverse=True)

    total = len(results)
    paginated = results[offset:offset + limit]
    has_more = (offset + limit) < total

    return {
        "nodes": paginated,
        "total": total,
        "has_more": has_more,
        "offset": offset,
        "limit": limit,
        "tier": tier,
    }


def _resolve_node(nodes, start, adj=None, rev_adj=None):
    """Match start against doc_id, entry_id, file_path, or symbol_name.
    Prefers exact matches, then entries that have graph edges."""
    if start in nodes:
        return start
    candidates = []
    for nid, doc in nodes.items():
        if doc.get("entry_id") == start or doc.get("file_path") == start or doc.get("symbol_name") == start:
            candidates.append(nid)
    if not candidates:
        return None
    if len(candidates) == 1:
        return candidates[0]
    # Multiple matches: prefer entries with graph edges, then exact file_path match
    for nid in candidates:
        has_edges = nid in adj or nid in rev_adj or any(nid == t for t, _ in adj.get(nid, [])) or any(nid == t for t, _ in rev_adj.get(nid, []))
        if has_edges:
            return nid
    for nid in candidates:
        doc = nodes[nid]
        if doc.get("file_path") == start:
            return nid
    return candidates[0]

def _bfs(nodes, adj, rev_adj, start, max_depth, direction="outbound"):
    """BFS traversal with direction support (outbound/inbound/both).
    
    direction:
      - "outbound": follow adj edges (what start calls/depends on)
      - "inbound": follow rev_adj edges (who calls/depends on start)
      - "both": follow both adj and rev_adj
    """
    start = _resolve_node(nodes, start, adj, rev_adj)
    if start is None:
        return {"visited_nodes": [], "edges_traversed": [], "start": None}
    visited = {start}
    order = [start]
    edges = []
    queue = deque([(start, 0)])
    while queue:
        node, depth = queue.popleft()
        if depth >= max_depth:
            continue
        # Outbound: what this node depends on/calls
        if direction in ("outbound", "both"):
            for edge in adj.get(node, []):
                nbr = edge[0]
                edges.append((node, nbr))
                if nbr not in visited:
                    visited.add(nbr)
                    order.append(nbr)
                    queue.append((nbr, depth + 1))
        # Inbound: who depends on/calls this node
        if direction in ("inbound", "both"):
            for edge in rev_adj.get(node, []):
                nbr = edge[0]
                edges.append((nbr, node))
                if nbr not in visited:
                    visited.add(nbr)
                    order.append(nbr)
                    queue.append((nbr, depth + 1))
    return {"visited_nodes": order, "edges_traversed": edges, "start": start}


def _detect_risk_labels(nodes, adj, rev_adj, edge_types):
    """Detect risk labels: high fan-out, circular dependencies, deep chains."""
    risks = []
    for nid, doc in nodes.items():
        out_count = len(adj.get(nid, []))
        in_count = len(rev_adj.get(nid, []))
        if out_count > HIGH_FAN_OUT_THRESHOLD:
            risks.append({
                "node": nid,
                "symbol": doc.get("symbol_name", nid),
                "file": doc.get("file_path", ""),
                "risk": "high_fan_out",
                "message": f"{doc.get('symbol_name', nid)} has {out_count} outgoing calls (>{HIGH_FAN_OUT_THRESHOLD})",
            })
    return risks


def _parse_cypher_like(query):
    """Parse a simplified Cypher-like query: MATCH/WHERE/RETURN/LIMIT subset.
    
    Supported syntax:
      MATCH (n:Label)-[:EDGE_TYPE]->(m:Label2)
      WHERE n.property = 'value' OR n.property =~ 'regex'
      RETURN n.name, m.name
      LIMIT N
    
    Returns dict with: match_pattern, where_conditions, return_fields, limit
    """
    result = {
        "match_pattern": None,
        "edge_type": None,
        "where_conditions": [],
        "return_fields": [],
        "limit": ROW_CEILING,
    }
    q = query.strip()

    # Extract LIMIT (search only, don't modify q)
    limit_match = re.search(r'\bLIMIT\s+(\d+)', q, re.IGNORECASE)
    if limit_match:
        result["limit"] = min(int(limit_match.group(1)), ROW_CEILING)

    # Extract RETURN
    return_match = re.search(r'\bRETURN\s+(.+?)(?:\s+WHERE|\s+LIMIT|\s*$)', q, re.IGNORECASE)
    if return_match:
        fields_str = return_match.group(1).strip()
        result["return_fields"] = [f.strip() for f in fields_str.split(',')]

    # Extract WHERE
    where_match = re.search(r'\bWHERE\s+(.+?)(?:\s+RETURN|\s+LIMIT|\s*$)', q, re.IGNORECASE)
    if where_match:
        where_str = where_match.group(1).strip()
        for part in re.split(r'\s+(?:AND|OR)\s+', where_str, flags=re.IGNORECASE):
            part = part.strip()
            if not part:
                continue
            eq_match = re.match(r'(\w+)\.(\w+)\s*=\s*[\'\"](.+?)[\'\"]', part)
            regex_match = re.match(r'(\w+)\.(\w+)\s*=~\s*[\'\"](.+?)[\'\"]', part)
            if eq_match:
                result["where_conditions"].append({
                    "var": eq_match.group(1),
                    "prop": eq_match.group(2),
                    "op": "=",
                    "value": eq_match.group(3),
                })
            elif regex_match:
                result["where_conditions"].append({
                    "var": regex_match.group(1),
                    "prop": regex_match.group(2),
                    "op": "=~",
                    "value": regex_match.group(3),
                })

    # Extract MATCH pattern: (n:Label)-[:EDGE_TYPE]->(m:Label2)
    match_match = re.search(
        r'\bMATCH\s+\((\w+)(?::(\w+))?\)-\[:(\w+)]->\((\w+)(?::(\w+))?\)',
        q, re.IGNORECASE
    )
    if match_match:
        result["match_pattern"] = {
            "var1": match_match.group(1),
            "label1": match_match.group(2),
            "edge_type": match_match.group(3),
            "var2": match_match.group(4),
            "label2": match_match.group(5),
        }

    return result


def _evaluate_cypher_query(parsed, nodes, adj, rev_adj, edge_types_map):
    """Execute parsed Cypher-like query against graph data."""
    rows = []
    pattern = parsed["match_pattern"]
    if not pattern:
        return rows

    var1 = pattern["var1"]
    var2 = pattern["var2"]
    edge_type = pattern["edge_type"]
    label1 = pattern.get("label1")
    label2 = pattern.get("label2")

    # Build node lookup by qualified_name or symbol_name
    node_by_name = {}
    for nid, doc in nodes.items():
        qname = doc.get("qualified_name", "")
        sym = doc.get("symbol_name", "")
        if qname:
            node_by_name[qname] = nid
        if sym:
            node_by_name.setdefault(sym, nid)

    # Find matching edges
    for doc_id in list_docs("code_edges"):
        edge = load_doc("code_edges", doc_id)
        if edge is None:
            continue
        if edge.get("edge_type") != edge_type:
            continue
        src_id = edge.get("source_id")
        tgt_id = edge.get("target_id")
        if src_id not in nodes or tgt_id not in nodes:
            continue
        src_doc = nodes[src_id]
        tgt_doc = nodes[tgt_id]

        # Label filters
        if label1 and src_doc.get("label") != label1:
            continue
        if label2 and tgt_doc.get("label") != label2:
            continue

        # WHERE conditions
        where_ok = True
        for cond in parsed["where_conditions"]:
            var = cond["var"]
            prop = cond["prop"]
            op = cond["op"]
            value = cond["value"]
            target_doc = src_doc if var == var1 else tgt_doc if var == var2 else None
            if target_doc is None:
                where_ok = False
                break
            doc_val = target_doc.get(prop, "")
            if op == "=":
                if str(doc_val) != value:
                    where_ok = False
                    break
            elif op == "=~":
                try:
                    if not re.search(value, str(doc_val)):
                        where_ok = False
                        break
                except re.error:
                    where_ok = False
                    break
        if not where_ok:
            continue

        # Build row
        row = {}
        for field in parsed["return_fields"]:
            if "." in field:
                var_name, prop_name = field.split(".", 1)
                target_doc = src_doc if var_name == var1 else tgt_doc if var_name == var2 else None
                row[field] = target_doc.get(prop_name, "") if target_doc else ""
            else:
                row[field] = ""
        rows.append(row)

        if len(rows) >= parsed["limit"]:
            break

    return rows


def _cmd_graph_query(args):
    """Execute Cypher-like graph query (MCP query_graph adapted)."""
    if len(args) < 4:
        print("Usage: hakoagent graph query '<cypher-like>' [--limit N]")
        print("  Example: hakoagent graph query \"MATCH (f:Function)-[:invokes]->(h:requests-http) RETURN f.name, h.url_path LIMIT 10\"")
        return 1
    query = args[3]
    limit = ROW_CEILING
    i = 4
    while i < len(args):
        if args[i] == "--limit" and i + 1 < len(args):
            try:
                limit = min(int(args[i + 1]), ROW_CEILING)
            except ValueError:
                pass
            i += 2
        else:
            i += 1

    nodes, adj, rev_adj, edge_types = _build_graph_with_edges()
    parsed = _parse_cypher_like(query)
    if limit < ROW_CEILING:
        parsed["limit"] = limit

    if not parsed["match_pattern"]:
        print("Error: Could not parse MATCH pattern from query.")
        print("  Example: MATCH (n:Label)-[:EDGE_TYPE]->(m:Label2)")
        return 1

    rows = _evaluate_cypher_query(parsed, nodes, adj, rev_adj, edge_types)
    truncated = len(rows) >= parsed["limit"]

    print(f"Query: {query}")
    print(f"  Rows returned: {len(rows)}")
    if truncated:
        print(f"  WARNING: Result truncated at row ceiling ({parsed['limit']})")
    if not rows:
        print("  No matching rows.")
    else:
        # Print header
        if parsed["return_fields"]:
            header = " | ".join(parsed["return_fields"])
            print(f"  {header}")
            print(f"  {'-' * len(header)}")
            for row in rows:
                values = " | ".join(str(row.get(f, "")) for f in parsed["return_fields"])
                print(f"  {values}")
    return 0


def _cmd_graph_detect_changes(args):
    """Map git diff to affected symbols in the knowledge graph (MCP detect_changes adapted)."""
    diff_path = None
    tier = "verify"
    i = 3
    while i < len(args):
        if args[i] == "--diff-path" and i + 1 < len(args):
            diff_path = args[i + 1]
            i += 2
        elif args[i] == "--tier" and i + 1 < len(args):
            tier = args[i + 1]
            i += 2
        else:
            i += 1

    # Get changed files from git diff
    changed_files = []
    if diff_path:
        try:
            with open(diff_path, "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("diff --git "):
                        parts = line.split()
                        for p in parts:
                            if p.startswith("a/") or p.startswith("b/"):
                                fp = p[2:]
                                if fp not in changed_files:
                                    changed_files.append(fp)
                        break
        except OSError:
            print(f"Error: Cannot read diff file: {diff_path}")
            return 1
    else:
        try:
            import subprocess
            result = subprocess.run(
                ["git", "diff", "--name-only"],
                capture_output=True, text=True, timeout=10
            )
            if result.returncode == 0:
                changed_files = [f for f in result.stdout.strip().split("\n") if f]
        except (OSError, subprocess.TimeoutExpired, FileNotFoundError):
            pass

    if not changed_files:
        print("No changed files detected.")
        return 0

    # Map changed files to code_index entries
    nodes = {}
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        nodes[doc_id] = doc

    affected_symbols = []
    affected_files = set()
    for nid, doc in nodes.items():
        fpath = doc.get("file_path", "")
        if fpath in changed_files:
            affected_symbols.append({
                "entry_id": doc.get("entry_id", nid),
                "symbol_name": doc.get("symbol_name", ""),
                "symbol_type": doc.get("symbol_type", ""),
                "file_path": fpath,
                "change_type": "modified",
                "actor": doc.get("actor", ""),
            })
            affected_files.add(fpath)

    print(f"Changed files ({len(changed_files)}):")
    for f in sorted(changed_files):
        print(f"  - {f}")
    print(f"Affected symbols ({len(affected_symbols)}):")
    for s in affected_symbols:
        print(f"  - {s['file_path']} :: {s['symbol_name']} ({s['symbol_type']})")
    print(f"Tier: {tier}")
    return 0


def _get_code_snippet(qualified_name, context_lines=5):
    """Return source code snippet by qualified symbol name (MCP get_code_snippet adapted)."""
    target_doc = None
    for doc_id in list_docs("code_index"):
        doc = load_doc("code_index", doc_id)
        if doc is None:
            continue
        if doc.get("qualified_name") == qualified_name or doc.get("symbol_name") == qualified_name:
            target_doc = doc
            break

    if target_doc is None:
        return None

    file_path = target_doc.get("file_path", "")
    line_number = target_doc.get("line_number", 1)
    symbol_name = target_doc.get("symbol_name", "")

    snippet = ""
    line_range = [line_number, line_number]
    try:
        src_path = Path(file_path)
        if not src_path.is_absolute():
            src_path = Path.cwd() / file_path
        if src_path.exists():
            with open(src_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
            start = max(0, line_number - 1 - context_lines)
            end = min(len(lines), line_number - 1 + context_lines)
            snippet = "".join(lines[start:end])
            line_range = [start + 1, end]
    except OSError:
        pass

    return {
        "qualified_name": qualified_name,
        "file_path": file_path,
        "symbol_name": symbol_name,
        "symbol_type": target_doc.get("symbol_type", ""),
        "snippet": snippet,
        "line_range": line_range,
        "actor": target_doc.get("actor", ""),
    }


