# ---------------------------------------------------------------------------
# Context cache (TTL + LRU-ish eviction via hit_count)
# ---------------------------------------------------------------------------

def _cache_key(query):
    return f"cache_{hashlib.sha256(query.encode()).hexdigest()[:16]}"


def cache_get_internal(query):
    key = _cache_key(query)
    doc = load_doc("context_cache", key)
    if not doc:
        return None
    ttl = doc.get("ttl_seconds", DEFAULT_TTL)
    created = doc.get("created_at")
    if created is not None:
        try:
            created_ts = float(created)
        except (ValueError, TypeError):
            created_ts = time.time()  # legacy ISO string: treat as fresh
        age = time.time() - created_ts
        if age > ttl:
            delete_doc("context_cache", key)
            return None
    doc["hit_count"] = doc.get("hit_count", 0) + 1
    doc["llm_calls_saved"] = doc.get("llm_calls_saved", 0) + 1
    save_doc("context_cache", key, doc)
    return doc


def cache_put_internal(query, summary, ttl):
    key = _cache_key(query)
    doc = {
        "cache_key": key,
        "query": query,
        "summary": summary,
        "source_documents": [],
        "created_at": now_ts(),
        "ttl_seconds": ttl,
        "hit_count": 0,
        "llm_calls_saved": 0,
    }
    clear_expired()
    # LRU eviction: remove lowest hit_count entry if over limit
    entries = []
    for doc_id, d in scan_docs("context_cache"):
        entries.append((doc_id, d.get("hit_count", 0)))
    if len(entries) >= MAX_CACHE_SIZE:
        entries.sort(key=lambda x: x[1])
        victim = entries[0][0]
        delete_doc("context_cache", victim)
        _inc_evictions()
    save_doc("context_cache", key, doc)
    return key


def clear_expired():
    """Remove all TTL-expired cache entries."""
    for doc_id, doc in scan_docs("context_cache"):
        created = doc.get("created_at")
        ttl = doc.get("ttl_seconds", DEFAULT_TTL)
        if created is not None:
            try:
                age = time.time() - float(created)
            except (ValueError, TypeError):
                age = 0
            if age > ttl:
                delete_doc("context_cache", doc_id)


